# Copia este archivo como .env y pon tu propia contraseña.
# El archivo .env NUNCA se sube a Git.

# ---------- Base de datos local (Docker) ----------
POSTGRES_USER=ventas_app
POSTGRES_PASSWORD=
POSTGRES_DB=sistema_ventas
POSTGRES_PORT=5432

# Cadena de conexión para la API (Prisma). Pon la misma contraseña de arriba.
DATABASE_URL=postgresql://ventas_app:CONTRASEÑA@localhost:5432/sistema_ventas?schema=ventas

# ---------- API ----------
API_PORT=3000
# Direcciones de la app web que pueden llamar a la API (separadas por coma)
CORS_ORIGENES=http://localhost:5173

# ---------- App web ----------
# Dirección de la API que usa la app (solo las variables VITE_ llegan al navegador)
VITE_API_URL=http://localhost:3000

# ---------- Firebase ----------
# API: ID del proyecto para verificar los tokens
FIREBASE_PROJECT_ID=
# Opcional (Tarea 5, crear usuarios desde la API): ruta al JSON de la cuenta de servicio, FUERA del proyecto
# GOOGLE_APPLICATION_CREDENTIALS=C:/claves/sirinventari-admin.json

# App web: Consola de Firebase → Configuración del proyecto → Tus apps → SDK
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=
